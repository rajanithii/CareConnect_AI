# BloodLink AI Landing Page - Analytics Configuration
# Copy this file to .env.local and add your actual tracking IDs

# Google Analytics 4 Configuration
# Get your Tracking ID from Google Analytics 4 property
# Format: G-XXXXXXXXXX
REACT_APP_GA_ID=G-XXXXXXXXXX

# Hotjar Configuration
# Get your Site ID from Hotjar dashboard
# Format: 12345678 (numeric)
REACT_APP_HOTJAR_ID=12345678

# API Configuration
# Backend API URL for frontend to communicate with
VITE_API_BASE_URL=http://localhost:8000

# Environment
REACT_APP_ENV=development

# Optional: Sentry Error Tracking (if using Sentry for error monitoring)
# REACT_APP_SENTRY_DSN=https://...

# Optional: Feature Flags
REACT_APP_ENABLE_ANALYTICS=true
REACT_APP_ENABLE_HEATMAPS=true
REACT_APP_ENABLE_ABTEST=true
